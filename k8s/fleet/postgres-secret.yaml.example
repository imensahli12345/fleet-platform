# EXAMPLE ONLY (named .yaml.example so "kubectl apply -f k8s/fleet/" skips it) - the real Secret is NOT stored in Git (a password in Git = leaked forever).
# Create the real one with a command instead:
#   kubectl create secret generic postgres-secret -n fleet \
#     --from-literal=POSTGRES_USER=postgres \
#     --from-literal=POSTGRES_PASSWORD=<choose-a-password>
#
# Note: Secret values are only base64-ENCODED, not encrypted. Anyone allowed to read Secrets
# can decode them. In production: Sealed Secrets, External Secrets, or a cloud secret manager.
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: fleet
type: Opaque
stringData:
  POSTGRES_USER: postgres
  POSTGRES_PASSWORD: change-me
